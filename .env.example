# Copy to `.env` (gitignored). Never commit real values.
#
# ABX Services credential — written for you by `npm run abx -- auth login`; you normally never
# type it. It identifies the account; it cannot sign transactions.
# ABX_SERVICES_API_KEY=

# Target network. Base Sepolia is the default; production is `base`. There is deliberately no
# --chain flag — select the chain here or inline: `ABX_CHAIN=base npm run abx -- ...`
# ABX_CHAIN=base-sepolia

# Optional: a healthy archive RPC per chain (public endpoints are getLogs-range-capped).
# ABX_RPC_URLS_BASE_SEPOLIA=
# ABX_RPC_URLS_BASE=
